{
  "manifest_version": 3,
  "name": "KNJ Internet Monitor",
  "version": "2.2.0",
  "description": "Monitor HTTP cada 3 segundos con alertas discretas",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.cloudflare.com/*",
    "https://api.telegram.org/*",
    "https://connection-smoky.vercel.app/*"
  ],
  "icons": {
    "32": "icon32.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KNJ Internet Monitor",
    "default_icon": {
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}