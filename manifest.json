{
  "manifest_version": 3,
  "name": "Internet Ping Test",
  "version": "1.0.0",
  "description": "Monitoreo de conectividad y latencia HTTP",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.cloudflare.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internet Ping Test"
  },
  "background": {
    "service_worker": "background.js"
  }
}